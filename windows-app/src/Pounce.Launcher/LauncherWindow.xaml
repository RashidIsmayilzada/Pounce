<Window x:Class="Pounce.Launcher.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Pounce.Launcher.Views"
        xmlns:themes="clr-namespace:Pounce.Launcher.Themes"
        Title="Pounce"
        Width="680" Height="56" MinHeight="56"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        Background="Transparent"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="{DynamicResource PrimaryTextBrush}"
        AutomationProperties.Name="Pounce search">

    <!-- A normal framed window whose frame is drawn over by the content: Windows still treats it as a framed window,
         so DWM gives it the shadow, the 1 px border, rounded corners and the system backdrop, with no layered
         (AllowsTransparency) window and no WPF effects. CaptionHeight 0: nothing to drag. GlassFrameThickness -1
         extends the DWM frame over the whole window, which is what lets the acrylic backdrop show through.
         When there is no backdrop, the content paints an opaque background over all of it (see LauncherWindow.xaml.cs). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Replaced by DarkTheme in code when the app theme is dark. -->
                <themes:LightTheme />
            </ResourceDictionary.MergedDictionaries>

            <!-- Replaced in code with the system accent colour. -->
            <SolidColorBrush x:Key="AccentBrush" Color="#FF0078D4" />
            <SolidColorBrush x:Key="SelectionBrush" Color="#380078D4" />

            <BooleanToVisibilityConverter x:Key="Visible" />

            <!-- The search field: just the text and caret, no border, no focus rectangle. -->
            <ControlTemplate x:Key="BareTextBox" TargetType="TextBox">
                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
            </ControlTemplate>

            <!-- One row: icon, name, location and passage; or icon, name and "Open" for an application. -->
            <DataTemplate x:Key="RowTemplate" DataType="{x:Type views:RowModel}">
                <Grid x:Name="RowGrid" Margin="12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="IconPlaceholder" Width="32" Height="32" CornerRadius="6" VerticalAlignment="Top"
                            Visibility="Collapsed" Background="{DynamicResource IconPlaceholderBrush}" />
                    <Image x:Name="Icon" Width="32" Height="32" VerticalAlignment="Top" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           views:IconLoader.Item="{Binding Item}" />

                    <StackPanel x:Name="TextColumn" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" />
                            <TextBlock x:Name="LocationText" Text="{Binding Location}" FontSize="11" Margin="8,0,0,1"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" />
                        </DockPanel>
                        <!-- At most two lines: the height is capped at two line heights and the last line trimmed. -->
                        <TextBlock views:SnippetView.Snippet="{Binding Snippet}" Margin="0,3,0,0"
                                   FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight" MaxHeight="32"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Visibility="{Binding HasSnippet, Converter={StaticResource Visible}}" />
                    </StackPanel>

                    <TextBlock x:Name="OpenHint" Grid.Column="2" Text="Open" FontSize="11" Margin="12,0,0,0"
                               VerticalAlignment="Center" Visibility="Collapsed"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsApp}" Value="True">
                        <Setter TargetName="RowGrid" Property="Margin" Value="12,6" />
                        <Setter TargetName="TextColumn" Property="VerticalAlignment" Value="Center" />
                        <Setter TargetName="LocationText" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsApp}" Value="True" />
                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="OpenHint" Property="Visibility" Value="Visible" />
                    </MultiDataTrigger>
                    <!-- No icon (yet): a neutral rounded square instead. -->
                    <DataTrigger Binding="{Binding Source, ElementName=Icon}" Value="{x:Null}">
                        <Setter TargetName="IconPlaceholder" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- The row's container: an optional section title, then the row with the selection background.
                 Not focusable, so the keyboard focus never leaves the search field; no hover effect, so the mouse
                 never looks like it moved the selection. Clicks are handled in code (RowMouseDown/RowMouseUp). -->
            <Style x:Key="RowContainer" TargetType="ListBoxItem">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="RowMouseDown" />
                <EventSetter Event="PreviewMouseLeftButtonUp" Handler="RowMouseUp" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Margin="12,6,12,2"
                                           IsHitTestVisible="False" Foreground="{DynamicResource SecondaryTextBrush}"
                                           Visibility="{Binding HasTitle, Converter={StaticResource Visible}}" />
                                <Border x:Name="RowBackground" CornerRadius="8" Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="RowBackground" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- The Canvas lets the content take its natural height; the window then follows it (Root_SizeChanged).
         Its background paints the whole window: the tint over the acrylic, or the opaque fallback. -->
    <Canvas x:Name="Host" Background="{DynamicResource PanelOpaqueBrush}">
        <StackPanel x:Name="Root" Width="680" SizeChanged="Root_SizeChanged">
            <Grid Height="56" Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                           VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock x:Name="Placeholder" Grid.Column="1" Margin="14,0,0,0" Text="Search apps and files"
                           FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="22" VerticalAlignment="Center"
                           IsHitTestVisible="False" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBox x:Name="SearchBox" Grid.Column="1" Margin="12,0,0,0" Template="{StaticResource BareTextBox}"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="22" VerticalAlignment="Center"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         Foreground="{DynamicResource PrimaryTextBrush}" CaretBrush="{DynamicResource PrimaryTextBrush}"
                         SelectionBrush="{DynamicResource AccentBrush}" FocusVisualStyle="{x:Null}"
                         AcceptsReturn="False" AcceptsTab="False" MaxLines="1"
                         TextChanged="SearchBox_TextChanged"
                         AutomationProperties.Name="Search apps and files" />
                <Ellipse x:Name="Spinner" Grid.Column="2" Width="16" Height="16" Margin="12,0,0,0" Visibility="Collapsed"
                         VerticalAlignment="Center" StrokeThickness="2" StrokeDashArray="15 7" StrokeDashCap="Round"
                         Stroke="{DynamicResource SecondaryTextBrush}" RenderTransformOrigin="0.5,0.5"
                         AutomationProperties.Name="Searching">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotation" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>

            <Border x:Name="Divider" Height="1" Background="{DynamicResource DividerBrush}" Visibility="Collapsed" />

            <ScrollViewer x:Name="ResultsScroller" Visibility="Collapsed" Focusable="False" IsTabStop="False"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False">
                <StackPanel Margin="6">
                    <ListBox x:Name="ResultsList" ItemTemplate="{StaticResource RowTemplate}"
                             ItemContainerStyle="{StaticResource RowContainer}"
                             Focusable="False" IsTabStop="False" KeyboardNavigation.TabNavigation="None"
                             IsSynchronizedWithCurrentItem="False" SelectionMode="Single"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             VirtualizingPanel.IsVirtualizing="False"
                             AutomationProperties.Name="Results">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ItemsPresenter />
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    <TextBlock x:Name="MessageText" Visibility="Collapsed" Padding="12" FontSize="13"
                               TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Canvas>
</Window>
